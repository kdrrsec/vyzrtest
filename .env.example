# i18n: English only (see src/i18n/routing.ts). URLs have no /en prefix.

# ── Important: Next.js does NOT read this file. Copy these lines to ".env.local"
#    in the same folder as package.json, then run `npm run dev` again.
#    (Windows Notepad: "Save as type" = All files → name `.env.local`)

# Shopify admin domain only (no https://)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API token (Headless channel or custom app). Either variable name works:
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token

# Admin API (custom app in Shopify â€” for scripts/agent: products, discounts, metafields).
# Never commit the real token. Scopes: see .env.example comment block below or team docs.
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHOPIFY_ADMIN_API_VERSION=2024-10

# Local dev only (Windows + antivirus/proxy): if products vanish and logs show
# UNABLE_TO_VERIFY_LEAF_SIGNATURE, set to 1. Do not use on Vercel/production.
# SHOPIFY_DEV_INSECURE_TLS=1

# Optional: 10% engraving discount when customer chooses "VYZR sources new visor".
# Create the code in Shopify Admin â†’ Discounts (percentage, engraving products only).
# SHOPIFY_VYZR_SUPPLIES_DISCOUNT_CODE=VYZR-VISOR-10

# Admin API (custom app in Shopify â€” for scripts/agent: products, discounts, metafields).
# Never commit the real token. Scopes: see .env.example comment block below or team docs.
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHOPIFY_ADMIN_API_VERSION=2024-10

