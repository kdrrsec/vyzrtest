# Dev server port (scripts/run-dev.cjs). Default 3001 if unset. Use 3000 for the old default.
# PORT=3001

# Optional: default product handle for /product when linking from home CTA
NEXT_PUBLIC_DEFAULT_PRODUCT_HANDLE=your-own-designed-visor

# Optional: Shopify collection handle for /shop/visors (Storefront API).
# If unset, the shop lists best-selling products from the whole catalog.
# NEXT_PUBLIC_SHOPIFY_VISORS_COLLECTION_HANDLE=laser-engraved-visor-service

# 3D viewer: omit or any value except 0 = simple placeholder mesh (works without a file).
# Set to 0 only when you add your model at public/models/visor-helmet.glb (then restart dev).
# NEXT_PUBLIC_VISOR_PLACEHOLDER=0

# Optional: header announcement (Blink-style strip). Defaults are built in if unset.
# NEXT_PUBLIC_ANNOUNCEMENT_LINE1=
# NEXT_PUBLIC_ANNOUNCEMENT_LINE2=

# Label next to search/cart (e.g. EUR). Not wired to Shopify Markets — display only.
# NEXT_PUBLIC_STORE_CURRENCY_LABEL=EUR

# Logo image in /public (default /logo.png). Override if you use another path.
# NEXT_PUBLIC_LOGO_SRC=/logo.png

# WhatsApp (floating button + “Book via WhatsApp” on Local Drop-Off). Digits only, country code, no + or spaces.
# Example Netherlands: 31612345678
# NEXT_PUBLIC_WHATSAPP_NUMBER=31612345678

# Calendly — in-person visor drop-off (10% engraving discount option).
# Public scheduling URL shown on the post-checkout booking page (required for drop-off flow).
# NEXT_PUBLIC_CALENDLY_DROPOFF_URL=https://calendly.com/your-account/visor-dropoff
# Optional: Calendly API token + event URI to generate single-use personalised links.
# CALENDLY_API_TOKEN=your_calendly_api_token
# CALENDLY_DROPOFF_EVENT_URI=https://api.calendly.com/event_types/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Full URL of your Vercel/production site (used for the ?return_to= redirect after Shopify checkout).
# NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Google Tag Manager (analytics, heatmaps, inactivity tags). Container ID from tagmanager.google.com
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Split custom upload from shop catalog (enabled by default).
# Custom product stays on its own page; shop shows standard designs only.
# Set to 0 to show all products together in /shop again.
# NEXT_PUBLIC_SEPARATE_CUSTOM_VISOR=1

# Customer design uploads (custom visor). Production: Vercel → Storage → Blob → read-write token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Local dev without Blob: files save to public/.local-uploads (auto when BLOB token is unset).
# Set DESIGN_UPLOAD_LOCAL=0 to disable the local fallback.

# Homepage hero video (MP4). Default: /public/hero.mp4 (no env needed if that file exists).
# Override path or use a full URL (Shopify Files, CDN). Set to "off" for static photo only.
# NEXT_PUBLIC_HERO_VIDEO_SRC=/hero.mp4
# Optional still shown while the video loads (defaults to /hero-photo.png).
# NEXT_PUBLIC_HERO_VIDEO_POSTER=/hero-photo.png

# WhatsApp (floating button + “Book via WhatsApp” on Local Drop-Off). Digits only, country code, no + or spaces.
# Example Netherlands: 31612345678
# NEXT_PUBLIC_WHATSAPP_NUMBER=31612345678

