{
  "name": "vyzr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "npx --yes rimraf@5 .next .next-dev node_modules/.cache",
    "dev": "node scripts/run-dev.cjs",
    "dev:turbo": "node scripts/run-dev.cjs dev --turbo",
    "dev:webpack": "node scripts/run-dev.cjs dev",
    "dev:clean": "npm run clean && node scripts/run-dev.cjs",
